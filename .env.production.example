# /home/sensei/farmhand/.env — never commit.

HTTP_PORT=8080

POSTGRES_USER=farmhand
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=farmhand

ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-admin-password

SEED_DEMO_PLAYERS=false
COOKIE_SECURE=true

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Balance agent (read-only judge + reasoner that stages tuning recommendations).
METRICS_VENICE_API_KEY=
METRICS_VENICE_DECISION_MODEL=jev-latest
METRICS_VENICE_TEXT_MODEL=deepseek-v4-pro
METRICS_VENICE_EXPLAIN_MODEL=deepseek-v4-flash

FH_IMAGE_PREFIX=ghcr.io/fg-clawdy/farmhand
FH_IMAGE_TAG=latest
