# Copy to .env and adjust. Docker Compose reads this automatically.

HTTP_PORT=80

POSTGRES_USER=farmhand
POSTGRES_PASSWORD=farmhand
POSTGRES_DB=farmhand

ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=farmhand-dev

# Set true only when serving over HTTPS.
COOKIE_SECURE=false

# Host folder bind-mounted into the API at /data/selfies. Point Immich at this path.
SELFIE_DROP_DIR=./data/selfies

# Parent PWA Web Push (VAPID). Generate with:
#   npm run vapid-keys -w @farmhand/api
# Never commit the private key. Leave blank to keep push disabled (inbox still works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:farmhand@localhost

# Venice AI paints the shared-goal jar lids. Leave the key blank to keep the
# pastel default lids. Any Venice image model id works; flux-3-image (default)
# is the highest-quality option, z-image-turbo the cheapest.
VENICE_API_KEY=
VENICE_IMAGE_MODEL=flux-3-image

# Amazon wishlists: JSON map of child name -> public Amazon wishlist URL.
# Keys are matched to child names case-insensitively; the retailer is inferred
# from the host. Weekly scrape + a "Sync now" button in the parent Store page.
# WISHLIST_URLS={"Sonny":"https://www.amazon.com/hz/wishlist/ls/302ZR21TZC2SC?ref_=wl_share"}
WISHLIST_URLS=
