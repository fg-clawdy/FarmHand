generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Mascot {
  cow
  chicken
  pig
  sheep
  horse
}

enum PlotPhase {
  empty
  growing
  purgatory
  wilted
}

enum ChoreRecurrence {
  DAILY
  WEEKLY
  WEEKDAYS
  NONE
}

enum ChoreTimeOfDay {
  MORNING
  AFTERNOON
  EVENING
  ANYTIME
}

enum ChorePriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum ChoreAssignmentMode {
  ALL
  SPECIFIC
  RACE
}

enum ChoreClaimStatus {
  PENDING
  APPROVED
  DENIED
  SKIPPED
}

enum ApprovalSubjectKind {
  chore_claim
  store_redemption
}

enum StoreRedemptionStatus {
  PENDING
  OWNED
  REDEEMED
  DENIED
}

enum WishlistItemStatus {
  PENDING
  CONFIRMED
  HIDDEN
  PURCHASED
}

enum PointLedgerKind {
  EARN_HARVEST
  EARN_GRANT
  HOLD_REWARD
  RELEASE_REWARD
  SPEND_REWARD
  ADJUST_ADMIN
  OPENING_BALANCE
  GIVE_SHARED
  RETURN_SHARED
}

model Admin {
  id                String             @id @default(uuid())
  username          String             @unique
  passwordHash      String
  createdAt         DateTime           @default(now())
  sessions          AdminSession[]
  auditLogs         AuditLog[]
  resolvedClaims      ChoreClaim[]
  resolvedRedemptions StoreRedemption[]  @relation("StoreResolved")
  redeemedRedemptions StoreRedemption[]  @relation("StoreRedeemed")
  pushSubscriptions   PushSubscription[]
  actionTokens        PushActionToken[]
}

model AdminSession {
  id        String   @id @default(uuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Player {
  id                      String          @id @default(uuid())
  name                    String
  mascot                  Mascot
  avatarKind               String          @default("mascot")
  avatarPreset             String?
  avatarSelfieFile         String?
  color                    String?
  pinHash                 String?
  seeds                   Int             @default(10)
  provisionalSeeds        Int             @default(0)
  lastParentNotifyAt      DateTime?
  points                  Int             @default(0)
  fertilizer              Int             @default(0)
  seedShards              Int             @default(0)
  moonDew                 Int             @default(0)
  growGoo                 Int             @default(0)
  phoenixAsh              Int             @default(0)
  lastIngredientClaimDate String?
  nextIngredientIndex     Int             @default(0)
  wateringsOnDate         String?
  wateringsCount          Int             @default(0)
  lastWateredAt           DateTime?
  selfieUnlockDate        String?
  selfieSeedGrantDate     String?
  isActive                Boolean         @default(true)
  givingEnabled           Boolean?        @default(true)
  giveCeiling             Int?            @default(100)
  familyJarCoachSeenAt    DateTime?
  amazonWishlistUrl       String?
  wishlistSyncedAt        DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  plots                   Plot[]
  sessions                PlayerSession[]
  activity                ActivityLog[]
  auditLogs               AuditLog[]
  choreAssignments        ChoreAssignment[]
  choreClaims             ChoreClaim[]
  accoladeCounters        AccoladeCounter[]
  accoladeDays            AccoladeActiveDay[]
  accoladeUnlocks         AccoladeUnlock[]
  storeRedemptions        StoreRedemption[]
  pointLedger             PointLedgerEvent[]
  choreBoardEvents        ChoreBoardEvent[]
  choreHeats              ChoreHeat[]
  basketItems             BasketItem[]
  sharedGoalEvents        SharedGoalEvent[]
  wishlistItems           WishlistItem[]
  systemAlerts            SystemAlert[]
  pointsReconciliationRuns PointsReconciliationRun[]
}

/// Produce picked but not yet sold. Stars stay here until Farmers Market sale.
model BasketItem {
  id        String    @id @default(uuid())
  playerId  String
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  cropKind  String
  name      String
  emoji     String
  points    Int
  /// held = in the basket. sold = converted to stars (kept for the ledger key).
  status    String    @default("held")
  soldAt    DateTime?
  saleId    String?
  createdAt DateTime  @default(now())

  @@index([playerId, status, createdAt])
  @@index([saleId])
}

model Plot {
  id                         String      @id @default(uuid())
  playerId                   String
  player                     Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  slot                       Int
  plantTier                  Int?
  plantedAt                  DateTime?
  phase                      PlotPhase   @default(empty)
  choreClaimId               String?     @unique
  choreClaim                 ChoreClaim? @relation(fields: [choreClaimId], references: [id], onDelete: SetNull)
  claimLinks                 PlotClaimLink[]
  waterReductionMinutes      Int         @default(0)
  fertilizerReductionMinutes Int         @default(0)
  lastWateredAt              DateTime?
  wateringsOnDate            String?
  wateringsCount             Int         @default(0)
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  @@unique([playerId, slot])
}

model Chore {
  id               String              @id @default(uuid())
  slug             String              @unique
  title            String
  emoji            String
  description      String              @default("")
  recurrence       ChoreRecurrence
  timeOfDay        ChoreTimeOfDay
  priority         ChorePriority       @default(NORMAL)
  estimatedMinutes Int?
  requiresApproval Boolean             @default(true)
  requiresSelfie   Boolean             @default(false)
  allowsSkip       Boolean             @default(false)
  isGlobal         Boolean             @default(false)
  includeInPath    Boolean             @default(false)
  isActive         Boolean             @default(true)
  legacyPoints     Int?
  difficulty       Int?
  seedReward       Int?
  claimWindowStart Int?
  claimWindowEnd   Int?
  assignmentMode   ChoreAssignmentMode
  sortOrder        Int                 @default(0)
  /// ISO weekday 1=Mon..7=Sun. Empty = every day. Backfilled from WEEKDAYS -> [1..5].
  activeDays       Int[]               @default([])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  assignments      ChoreAssignment[]
  claims           ChoreClaim[]
  raceSlots        ChoreRaceSlot[]
  boardEvents     ChoreBoardEvent[]
  heats           ChoreHeat[]
  playbookItems    ChorePlaybookItem[]
}

model ChoreAssignment {
  id        String   @id @default(uuid())
  choreId   String
  chore     Chore    @relation(fields: [choreId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([choreId, playerId])
}

/// A bundled chore mission with a broadcast window (e.g. "Morning", "Bedtime").
model ChorePlaybook {
  id          String              @id @default(uuid())
  slug        String              @unique
  title       String
  emoji       String
  description String              @default("")
  /// Broadcast window start (minutes since midnight, family tz). Null = open.
  windowStart Int?
  /// Broadcast window end (minutes since midnight, family tz). Null = open.
  windowEnd   Int?
  isActive    Boolean             @default(true)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       ChorePlaybookItem[]
}

/// Many-to-many: one chore can belong to multiple playbooks, in a fixed order.
model ChorePlaybookItem {
  id         String        @id @default(uuid())
  playbookId String
  playbook   ChorePlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  choreId    String
  chore      Chore         @relation(fields: [choreId], references: [id], onDelete: Cascade)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())

  @@unique([playbookId, choreId])
  @@index([choreId])
}

model ChoreRaceSlot {
  id        String   @id @default(uuid())
  choreId   String
  chore     Chore    @relation(fields: [choreId], references: [id], onDelete: Cascade)
  periodKey String
  createdAt DateTime @default(now())

  @@unique([choreId, periodKey])
}

model ChoreClaim {
  id                String           @id @default(uuid())
  choreId           String
  chore             Chore            @relation(fields: [choreId], references: [id], onDelete: Cascade)
  playerId          String
  player            Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  periodKey         String
  status            ChoreClaimStatus @default(PENDING)
  slot              Int?
  plantTier         Int?
  seedsGranted      Int              @default(1)
  seedsPlanted      Int              @default(0)
  proofJpegPath     String?
  claimedAt         DateTime         @default(now())
  resolvedAt        DateTime?
  resolvedByAdminId String?
  resolvedBy        Admin?           @relation(fields: [resolvedByAdminId], references: [id], onDelete: SetNull)
  plot              Plot?
  plotLinks         PlotClaimLink[]

  @@unique([choreId, playerId, periodKey])
  @@index([status, claimedAt])
}


/// Durable link: which pending chore claim(s) funded provisional seeds on a plant.
model PlotClaimLink {
  id         String     @id @default(uuid())
  plotId     String
  plot       Plot       @relation(fields: [plotId], references: [id], onDelete: Cascade)
  claimId    String
  claim      ChoreClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  seedsUsed  Int        @default(1)
  createdAt  DateTime   @default(now())

  @@unique([plotId, claimId])
  @@index([claimId])
}

model PlayerSession {
  id        String   @id @default(uuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model GameConfigRow {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  playerId  String?
  player    Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([playerId, createdAt])
  @@index([action, createdAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
}

model PushActionToken {
  id          String              @id @default(uuid())
  tokenHash   String              @unique
  adminId     String
  admin       Admin               @relation(fields: [adminId], references: [id], onDelete: Cascade)
  subjectKind ApprovalSubjectKind
  subjectId   String
  expiresAt   DateTime
  createdAt   DateTime            @default(now())

  @@unique([adminId, subjectKind, subjectId])
  @@index([subjectKind, subjectId])
  @@index([expiresAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  adminId        String?
  admin          Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  targetPlayerId String?
  targetPlayer   Player?  @relation(fields: [targetPlayerId], references: [id], onDelete: SetNull)
  action         String
  details        Json?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model AccoladeCounter {
  id             String   @id @default(uuid())
  playerId       String
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  seasonKey      String
  harvests       Int      @default(0)
  waterings      Int      @default(0)
  plantings      Int      @default(0)
  selfies        Int      @default(0)
  chorePhotos    Int      @default(0)
  cropsMask      Int      @default(0)
  morningPlaybooks Int    @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([playerId, seasonKey])
}

model AccoladeActiveDay {
  id        String @id @default(uuid())
  playerId  String
  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  dayKey    String
  seasonKey String

  @@unique([playerId, dayKey])
  @@index([playerId, seasonKey])
}

model StoreSku {
  id           String            @id @default(uuid())
  slug         String            @unique
  title        String
  emoji        String
  description  String            @default("")
  pointCost    Int
  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  redemptions  StoreRedemption[]
}

/// A single row of a child's Amazon wishlist, scraped weekly.
model WishlistItem {
  id             String             @id @default(uuid())
  playerId       String
  player         Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  retailer       String             @default("amazon")
  asin           String?
  title          String
  productUrl     String?
  imageUrl       String?
  priceCents     Int?
  pointCost      Int?
  status         WishlistItemStatus @default(PENDING)
  needsAttention Boolean            @default(false)
  lastSeenAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  redemptions    StoreRedemption[]

  @@index([playerId, status])
  @@index([playerId, retailer, asin])
}

model StoreRedemption {
  id                String                @id @default(uuid())
  playerId          String
  player            Player                @relation(fields: [playerId], references: [id], onDelete: Cascade)
  skuId             String?
  sku               StoreSku?             @relation(fields: [skuId], references: [id], onDelete: SetNull)
  wishlistItemId    String?
  wishlistItem      WishlistItem?         @relation(fields: [wishlistItemId], references: [id], onDelete: SetNull)
  source            String                @default("catalog")
  productUrl        String?
  status            StoreRedemptionStatus @default(PENDING)
  title             String
  emoji             String
  description       String                @default("")
  pointCost         Int
  pointsHeld        Int
  requestedAt       DateTime              @default(now())
  resolvedAt        DateTime?
  resolvedByAdminId String?
  resolvedBy        Admin?                @relation("StoreResolved", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  deniedAt          DateTime?
  denyReason        String                @default("")
  redeemedAt        DateTime?
  redeemedByAdminId String?
  redeemedBy        Admin?                @relation("StoreRedeemed", fields: [redeemedByAdminId], references: [id], onDelete: SetNull)
  events            StoreRewardEvent[]
  ledgerEvents      PointLedgerEvent[]

  @@index([playerId, status])
  @@index([status, requestedAt])
}

model StoreRewardEvent {
  id           String          @id @default(uuid())
  redemptionId String
  redemption   StoreRedemption @relation(fields: [redemptionId], references: [id], onDelete: Cascade)
  fromStatus   String?
  toStatus     String
  adminId      String?
  note         String          @default("")
  createdAt    DateTime        @default(now())

  @@index([redemptionId, createdAt])
}

model PointLedgerEvent {
  id              String           @id @default(uuid())
  playerId        String
  player          Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  kind            PointLedgerKind
  amount          Int
  idempotencyKey  String           @unique
  redemptionId    String?
  redemption      StoreRedemption? @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  source          String           @default("")
  meta            Json?
  createdAt       DateTime         @default(now())

  @@index([playerId, createdAt])
  @@index([playerId, kind])
}

model AccoladeUnlock {
  id         String   @id @default(uuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  slug       String
  kind       String
  seasonKey  String   @default("")
  medal      String   @default("")
  title      String
  emoji      String
  blurb      String   @default("")
  unlockedAt DateTime @default(now())

  @@unique([playerId, slug, seasonKey, medal])
  @@index([playerId, unlockedAt])
}


enum ChoreBoardEventType {
  BOARD_OPEN
  CLAIM
  DISMISS
  RIGHT_NOW_IMPRESSION
}

enum ChoreBoardTimeBucket {
  MORNING
  AFTERNOON
  EVENING
}

enum ChoreBoardSource {
  GARDEN_JOB_BOARD
  FARM_CORKBOARD
}

/// Append-only Job Board / corkboard interaction events for HEAT learning.
model ChoreBoardEvent {
  id              String               @id @default(uuid())
  createdAt       DateTime             @default(now())
  familyTimezone  String?
  playerId        String?
  player          Player?              @relation(fields: [playerId], references: [id], onDelete: SetNull)
  choreId         String?
  chore           Chore?               @relation(fields: [choreId], references: [id], onDelete: SetNull)
  eventType       ChoreBoardEventType
  timeOfDayBucket ChoreBoardTimeBucket
  isWeekend       Boolean
  source          ChoreBoardSource
  suggestedSlot   Boolean?
  meta            Json?

  @@index([createdAt])
  @@index([choreId, eventType, createdAt])
  @@index([eventType, createdAt])
}

/// Farm-wide aggregated claim heat per chore (v1: one row per choreId, playerId null).
/// heatScore is 0–100. See apps/api/src/choreHeat.ts for nightly + EMA formulas.
model ChoreHeat {
  id            String    @id @default(uuid())
  choreId       String    @unique
  chore         Chore     @relation(fields: [choreId], references: [id], onDelete: Cascade)
  playerId      String?
  player        Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
  heatScore     Float     @default(0)
  claimCount7d  Int       @default(0)
  claimCount30d Int       @default(0)
  openCount7d   Int       @default(0)
  lastClaimedAt DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([updatedAt])
}

enum SharedGoalStatus {
  WAITING
  OPEN
  READY
  HAPPENED
  CANCELLED
}

enum SharedGoalArtStatus {
  DEFAULT
  QUEUED
  READY
  FAILED
}

model SharedGoal {
  id           String              @id @default(uuid())
  title        String
  emoji        String
  targetPoints Int
  status       SharedGoalStatus    @default(WAITING)
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  readyAt      DateTime?
  happenedAt   DateTime?
  cancelledAt  DateTime?
  tintIndex    Int                 @default(0)
  artUrl       String?
  artStatus    SharedGoalArtStatus @default(DEFAULT)
  artPrompt    String?
  artNotes     String?
  events       SharedGoalEvent[]

  @@index([status, createdAt])
  @@index([status, sortOrder])
}

model SharedGoalEvent {
  id             String     @id @default(uuid())
  goalId         String
  goal           SharedGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  playerId       String
  player         Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  kind           String
  amount         Int
  idempotencyKey String     @unique
  createdAt      DateTime   @default(now())

  @@index([goalId, createdAt])
  @@index([playerId, createdAt])
}
enum SystemAlertStatus {
  OPEN
  RESOLVED
}

/// Raised when an invariant is violated (e.g. Player.points != ledger).
model SystemAlert {
  id         String            @id @default(uuid())
  kind       String
  severity   String            @default("warning") // "info" | "warning" | "critical"
  message    String
  details    Json?
  playerId   String?
  player     Player?           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status     SystemAlertStatus @default(OPEN)
  resolvedAt DateTime?
  createdAt  DateTime          @default(now())

  @@index([status, createdAt])
  @@index([kind, createdAt])
}

/// Append-only reconciliation run. One row per check. Watermark = ledgerHighWater.
model PointsReconciliationRun {
  id              String   @id @default(uuid())
  playerId        String
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  ledgerPoints    Int
  storedPoints    Int
  matched         Boolean
  repaired        Boolean  @default(false)
  ledgerHighWater String?  // idempotencyKey of the newest ledger row processed
  createdAt       DateTime @default(now())

  @@index([playerId, createdAt])
}
enum RecommendationSetStatus {
  OPEN
  RESOLVED
  SUPERSEDED
}

enum TuningChangeStatus {
  PENDING
  APPLIED
  DISMISSED
  SUPERSEDED
}

/// One balance-agent run. `snapshot` is the immutable window the model saw (for
/// review/discuss). Settings transition OPEN -> RESOLVED/SUPERSEDED only.
model RecommendationSet {
  id         String                  @id @default(uuid())
  status     RecommendationSetStatus @default(OPEN)
  snapshot   Json                    // balanceKnobs + 7d/30d windows + balanceGoals fingerprint
  modelIds   Json                    // { decision, text, explain }
  summary    String                  // plain-language headline
  notifiedAt DateTime?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  changes TuningChange[]

  @@index([status, createdAt])
}

/// A single proposed knob delta, addressed by JSON path into GameConfigRow.data.
/// Values are JSON-encoded strings so they round-trip exactly and are only
/// evaluated/bound when a parent applies (or overrides) them.
model TuningChange {
  id              String            @id @default(uuid())
  setId           String
  path            String
  label           String
  unit            String
  baselineValue   String
  proposedValue   String
  appliedValue    String?
  rationale       String
  status          TuningChangeStatus @default(PENDING)
  sortOrder       Int               @default(0)
  appliedAt       DateTime?
  appliedByAdminId String?
  createdAt       DateTime          @default(now())

  set RecommendationSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId, status, sortOrder])
  @@index([setId, status])
}
